                  <formatted-text>
                    <run bold='true' fontcolor='#a4b3c4' fontname='Source Sans Pro' fontsize='15'>Evolución temporal de mis </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#a4b3c4' fontname='Source Sans Pro' fontsize='15'>ratings (histórico)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
