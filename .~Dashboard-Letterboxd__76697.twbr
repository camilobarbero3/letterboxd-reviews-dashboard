                </zone>
              </zone>
              <zone fixed-size='431' h='23944' id='23' is-fixed='true' param='vert' type-v2='layout-flow' w='100000' x='0' y='27334'>
                <zone h='23944' id='25' param='horz' type-v2='layout-flow' w='100000' x='0' y='27334'>
                  <zone fixed-size='525' h='23944' id='37' is-fixed='true' param='horz' type-v2='layout-flow' w='52500' x='0' y='27334'>
                    <zone h='23944' id='38' name='Scatterplot_reviews_likes_sexodirector' w='52500' x='0' y='27334'>
                      <layout-cache minheight='221' minwidth='178' type-h='scalable' type-w='scalable' />
                      <zone-style>
                        <format attr='border-color' value='#000000' />
                        <format attr='border-style' value='none' />
                        <format attr='border-width' value='0' />
                        <format attr='margin' value='4' />
                      </zone-style>
                    </zone>
                  </zone>
                  <zone h='23944' id='26' param='horz' type-v2='layout-flow' w='47500' x='52500' y='27334'>
                    <zone h='23944' id='30' param='vert' type-v2='layout-flow' w='47500' x='52500' y='27334'>
                      <zone forceUpdate='true' h='2777' id='35' type-v2='text' w='47500' x='52500' y='27334'>
                        <formatted-text>
                          <run bold='true' fontcolor='#a4b3c4' fontname='Source Sans Pro' fontsize='12'>Afecta que la pelicula sea dirigida por una mujer en la plataforma Letterboxd?</run>
                        </formatted-text>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
                          <format attr='border-style' value='none' />
                          <format attr='border-width' value='0' />
                          <format attr='margin' value='4' />
                        </zone-style>
                      </zone>
                      <zone h='8777' id='83' param='vert' type-v2='layout-flow' w='47500' x='52500' y='30111'>
                        <zone forceUpdate='true' h='8777' id='84' type-v2='text' w='47500' x='52500' y='30111'>
                          <formatted-text>
                            <run fontcolor='#a4b3c4' fontname='Source Sans Pro' fontsize='11'>Cabe aclarar el modelo de regresión no es muy conveniente en este caso por el hecho de ser una muestra chica, particularmente para peliculas hechas por mujeres, y que Barbie, que fue casi la única pelicula en mucho tiempo hecha por una mujer que tuvo un exito como el visto el año pasado, nubla el modelo de regresion para parezca que la tendencia es parecida entre el sexo de los directores.</run>
                            <run>Æ&#10;&#10;</run>
                            <run fontcolor='#a4b3c4' fontname='Source Sans Pro' fontsize='11'>En este caso Barbie, podria ser considerado un outlier.</run>
                          </formatted-text>
                          <zone-style>
                            <format attr='border-color' value='#000000' />
                            <format attr='border-style' value='none' />
                            <format attr='border-width' value='0' />
                            <format attr='margin' value='4' />
                          </zone-style>
                        </zone>
                      </zone>
                      <zone fixed-size='57' forceUpdate='true' h='3611' id='79' is-fixed='true' type-v2='text' w='47500' x='52500' y='38888'>
                        <formatted-text>
                          <run bold='true' fontalignment='1' fontcolor='#a4b3c4' fontname='Source Sans Pro' fontsize='14'>Rating promedio en la plataforma</run>
                        </formatted-text>
                        <zone-style>
