                  <formatted-text>
                    <run bold='true' fontcolor='#a4b3c4' fontname='Source Sans Pro' fontsize='12'>Afecta que la pelicula sea dirigida por una mujer en la plataforma Letterboxd?</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
