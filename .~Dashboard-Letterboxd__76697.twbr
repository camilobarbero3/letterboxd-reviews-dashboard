                  <zone h='18501' id='170' param='horz' type-v2='layout-flow' w='100000' x='0' y='69777'>
                    <zone fixed-size='348' h='18501' id='174' is-fixed='true' param='vert' type-v2='layout-flow' w='34800' x='0' y='69777'>
                      <zone fixed-size='59' forceUpdate='true' h='3722' id='175' is-fixed='true' type-v2='text' w='34800' x='0' y='69777'>
                        <formatted-text>
                          <run bold='true' fontcolor='#a4b3c4' fontname='Source Sans Pro' fontsize='15'>Evolución temporal de mis </run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#a4b3c4' fontname='Source Sans Pro' fontsize='15'>ratings (histórico)</run>
                        </formatted-text>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
