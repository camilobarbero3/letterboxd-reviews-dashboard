                      <zone alt-text='Barbie&apos;s Greta Gerwing Oscar Snub' fixed-size='992' h='8333' id='68' is-fixed='true' is-scaled='1' param='/Users/camilobarbero/Documents/ITBA/1Q2024/Visualización de Información/TP/Imagenes/greta_oscars.png' type-v2='bitmap' url='https://www.hollywoodreporter.com/movies/movie-news/greta-gerwig-snubbed-oscars-2024-best-director-nominations-1235803664/' w='100000' x='0' y='51278'>
