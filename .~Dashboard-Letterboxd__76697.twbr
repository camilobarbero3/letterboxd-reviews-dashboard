                  <formatted-text>
                    <run bold='true' fontcolor='#f5f5f5' fontname='Source Sans Pro' fontsize='18' underline='true'>Hay un efecto en el sexo del director en mis ratings?</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
