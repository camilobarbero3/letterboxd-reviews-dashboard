                </zone>
                <zone alt-text='Oscar 2024: These are the only 8 women ever nomianted for Best Director' h='7001' id='52' is-scaled='1' param='/Users/camilobarbero/Documents/ITBA/1Q2024/Visualización de Información/TP/Imagenes/oscar.png' type-v2='bitmap' url='https://www.glamourmagazine.co.uk/article/oscars-2024-female-directors' w='100000' x='0' y='20333'>
                  <zone-style>
